# Copiar a .env y cambiar los valores antes de producción.

# Base de datos (solo la usa el backend)
DB_NAME=proyecto25
DB_USER=proyecto25
DB_PASSWORD=cambiar_esta_clave

# JWT: mínimo 32 caracteres aleatorios (por ejemplo: openssl rand -base64 48)
JWT_SECRET=cambiar_este_secreto_por_uno_largo_y_aleatorio_de_64_caracteres
JWT_EXPIRACION_HORAS=8

# Clave compartida para servicios internos (cabecera X-Service-Key)
SERVICE_KEY=cambiar_esta_clave_de_servicio

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGENES=http://localhost,http://localhost:5173

# Puerto HTTP publicado por nginx
HTTP_PORT=80

# Correo (en desarrollo MailHog, sin TLS; en producción SMTP con STARTTLS=true)
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_STARTTLS=false
MAIL_AUTH=false
MAIL_REMITENTE=direccion.psicologia@ejemplo.edu.bo
